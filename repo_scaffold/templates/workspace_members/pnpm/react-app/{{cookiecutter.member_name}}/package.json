{
  "name": "{{ cookiecutter.package_name }}",
  "version": "0.1.0",
  "private": {{ cookiecutter.private | lower }},
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "react": "{{ cookiecutter.react_version }}",
    "react-dom": "{{ cookiecutter.react_version }}",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "{{ cookiecutter.biome_version }}",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "typescript": "{{ cookiecutter.typescript_version }}",
    "vite": "{{ cookiecutter.vite_version }}",
    "vitest": "{{ cookiecutter.vitest_version }}"
  }
}
