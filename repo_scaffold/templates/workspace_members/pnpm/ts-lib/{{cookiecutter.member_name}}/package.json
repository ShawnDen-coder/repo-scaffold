{
  "name": "{{ cookiecutter.package_name }}",
  "version": "0.1.0",
  "private": {{ cookiecutter.private | lower }},
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "{{ cookiecutter.biome_version }}",
    "typescript": "{{ cookiecutter.typescript_version }}",
    "vitest": "{{ cookiecutter.vitest_version }}"
  }
}
