{
  "name": "{{ cookiecutter.package_name }}",
  "version": "0.1.0",
  "private": {{ cookiecutter.private | lower }},
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {"express": "^5.1.0"},
  "devDependencies": {
    "@biomejs/biome": "{{ cookiecutter.biome_version }}",
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "{{ cookiecutter.typescript_version }}",
    "vitest": "{{ cookiecutter.vitest_version }}"
  }
}
