{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
  ],
  // repo-scaffold is a Python project
  enabledManagers: ["pep621", "github-actions"],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      pinDigests: false,
    },
    {
      // Cookiecutter placeholders are not valid package names until rendered.
      matchManagers: ["pep621"],
      matchFileNames: ["repo_scaffold/templates/**/pyproject.toml"],
      enabled: false,
    },
    {
      matchManagers: ["pep621"],
      matchDepTypes: ["dev", "optional-dependencies"],
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch"],
      pinDigests: false,
      automerge: true,
    },
    {
      matchManagers: ["github-actions"],
      matchDepNames: ["ShawnDen-coder/repo-scaffold"],
      matchUpdateTypes: ["major", "minor", "patch"],
      groupName: "repo-scaffold workflows",
      pinDigests: false,
      automerge: false,
      labels: ["dependencies", "github-actions"],
    },
  ],
}
